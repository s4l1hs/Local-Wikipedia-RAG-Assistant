# ── Local Wikipedia RAG Assistant — environment overrides ─────────────────────
#
# Copy this file to .env and adjust values as needed.
# The system runs ENTIRELY OFFLINE — no API keys required.
# All settings below have sensible defaults in src/config.py.
#
# Usage:
#   cp .env.example .env
#   # edit .env as needed
#   python scripts/01_fetch_wikipedia.py

# ── LLM (served by local Ollama) ──────────────────────────────────────────────
# Available after: ollama pull llama3.2
# Options: llama3.2 | phi3 | mistral
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Generation behaviour
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512

# ── Embedding model ───────────────────────────────────────────────────────────
# "nomic-embed-text"  → requires: ollama pull nomic-embed-text   (recommended)
# "all-MiniLM-L6-v2" → uses sentence-transformers, no Ollama pull needed (fallback)
EMBEDDING_MODEL=nomic-embed-text

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5
MAX_CONTEXT_TOKENS=2000

# ── Similarity thresholds (cosine, nomic-embed-text calibrated) ───────────────
# Below LOW  → return "I don't know" without calling LLM
# LOW..MID   → call LLM with low-confidence prefix
# Above MID  → full answer
SIMILARITY_THRESHOLD_LOW=0.30
SIMILARITY_THRESHOLD_MID=0.45

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_COLLECTION_NAME=wikipedia_rag
